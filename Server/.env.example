# Server Environment Variables Template
PORT=3001
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_secure_256bit_random_jwt_secret
COOKIE_SECRET=your_secure_cookie_signing_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Render production:
# NODE_ENV=production
# CLIENT_URL=https://taktikal.netlify.app
# MONGO_URI=...
# JWT_SECRET=...
# COOKIE_SECRET=...
